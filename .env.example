# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=

# Optional. Vision model used to transcribe scanned pages and images.
# COOKBOOK_VISION_MODEL=claude-haiku-5-5
# Optional. Longest side, in pixels, of the page image sent to the model.
# COOKBOOK_MAX_IMAGE_EDGE=2000
# Optional. Where model responses are cached.
# COOKBOOK_CACHE_DIR=.cache
